    "@types/node": "22.19.15",
    "@types/react": "19.1.17",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "zod": "4.4.3"
  }
